{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tectora",
  "version": "0.5.0",
  "identifier": "cz.tectora.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tectora",
        "width": 1360,
        "height": 860,
        "minWidth": 600,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxOEU4QTFBNUQ0ODk0NTAKUldSUWxFaGRHb3FPNFZNc1IvbUt2UTJTWnRYTUJjdkt2eHlxUHNkUW0rU1FyVmdVdVFBSWZPVTAK",
      "endpoints": [
        "https://github.com/jakubkodajek/Tectora/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "tectora"
        ],
        "name": "Tectora project",
        "description": "Tectora roof project",
        "role": "Editor",
        "mimeType": "application/x-tectora"
      },
      {
        "ext": [
          "tectorajob"
        ],
        "name": "Tectora job",
        "description": "Tectora job with drawings and history",
        "role": "Editor",
        "mimeType": "application/x-tectorajob"
      }
    ]
  }
}
